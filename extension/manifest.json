{
  "manifest_version": 3,
  "name": "Teams RTL",
  "version": "0.1.0",
  "description": "Automatic Hebrew and English paragraph direction in Teams, sidebar controls, and a separate chat window during calls.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "windows.js"
  },
  "action": {
    "default_title": "Teams RTL controls",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": [
        "direction.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
